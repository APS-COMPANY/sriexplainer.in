{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sri Explainer",
  "version": "1.0.0",
  "identifier": "in.sriexplainer.app",
  "build": {
    "frontendDist": "https://sriexplainer.in",
    "devUrl": "https://sriexplainer.in"
  },
  "app": {
    "windows": [
      {
        "title": "Sri Explainer",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
