{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sri Explainer Control Center",
  "version": "1.0.0",
  "identifier": "in.sriexplainer.controlcenter",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "windows": [
      {
        "title": "Sri Explainer Mission Control",
        "width": 1280,
        "height": 850,
        "minWidth": 960,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "backgroundColor": "#07090E"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
